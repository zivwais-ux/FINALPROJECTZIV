# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
MODEL=gpt-4.1-mini

# Run history (Supabase project "churn-pipeline"). Optional: without these the
# pipeline skips recording runs and the web app shows the report files instead.
SUPABASE_URL=https://phxaicuxmyjcqwxwwhtz.supabase.co
# Read-only for the web app (row level security allows select only).
